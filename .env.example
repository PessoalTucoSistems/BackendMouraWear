# Porta local
PORT=3001

# URL(s) do frontend na Vercel, separadas por vírgula (CORS + retorno do pagamento)
FRONTEND_URL=http://localhost:5173

# URL pública desta API (usada nas URLs das imagens e no webhook do Mercado Pago)
# Ex.: https://backendmourawear.onrender.com
PUBLIC_API_URL=http://localhost:3001

# PostgreSQL (no Render é preenchido automaticamente). Sem ele, usa SQLite local em ./data
# DATABASE_URL=postgresql://user:password@host:5432/moreirawear

# Chave para assinar os tokens de login (use uma string longa e aleatória)
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Senha do admin moreirawear@admin.com (padrão 12345678).
# Alterar este valor no Render redefine a senha do admin no próximo deploy.
ADMIN_PASSWORD=12345678

# Opcional: habilita pagamento online (Checkout Pro do Mercado Pago)
# MP_ACCESS_TOKEN=APP_USR-...
